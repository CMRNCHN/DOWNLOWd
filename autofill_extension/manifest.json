{
  "manifest_version": 3,
  "name": "Provision Field Autofill",
  "version": "1.0.0",
  "description": "Offers to fill signup form fields (beyond username/password) from the current HQ upload's profile. Never submits a form.",
  "key": "",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://signup.live.com/*",
        "https://www.hyatt.com/*",
        "https://www.marriott.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
